def create_match_parameters_page(match_criteria_name):
        vbox = Gtk.VBox()
        str = match_criteria[match_criteria_name]["description"]
        description_text = Gtk.Label(label=str)
        description_text.set_use_markup(True)
        description_text.set_line_wrap(True)
        vbox.pack_start(description_text, False, False, 0)

        # three hboxes
        hbox_is, hbox_contains, hbox_matches = Gtk.HBox(), Gtk.HBox(), Gtk.HBox()

        # Three Check boxes for negation
        match_criteria[match_criteria_name]["is_not_checkbox"] = Gtk.CheckButton(label="does not")
        match_criteria[match_criteria_name]["contains_not_checkbox"] = Gtk.CheckButton(label="does not")
        match_criteria[match_criteria_name]["matches_not_checkbox"] = Gtk.CheckButton(label="does not")

        is_not_checkbox = match_criteria[match_criteria_name]["is_not_checkbox"]
        contains_not_checkbox = match_criteria[match_criteria_name]["contains_not_checkbox"]
        matches_not_checkbox = match_criteria[match_criteria_name]["matches_not_checkbox"]

        # We have to reflect the check box state somewhere
        is_not_checkbox.connect("toggled", toggle_this, "is", match_criteria_name)
        contains_not_checkbox.connect("toggled", toggle_this, "contains", match_criteria_name)
        matches_not_checkbox.connect("toggled", toggle_this, "matches", match_criteria_name)

        # Three text entries
        match_criteria[match_criteria_name]["entry_is"] = Gtk.Entry()
        match_criteria[match_criteria_name]["entry_contains"] = Gtk.Entry()
        match_criteria[match_criteria_name]["entry_matches"] = Gtk.Entry()

        entry_is = match_criteria[match_criteria_name]["entry_is"]
        entry_contains = match_criteria[match_criteria_name]["entry_contains"]
        entry_matches = match_criteria[match_criteria_name]["entry_matches"]

        # Three labels
        MatchMethod_text_is=Gtk.Label(label=_("equal(s)"))
        MatchMethod_text_contains=Gtk.Label(label=_("contain(s)"))
        MatchMethod_text_matches=Gtk.Label(label=_("match(es)"))

        # Pack the triads
        hbox_is.pack_start(is_not_checkbox, False, False, 0)
        hbox_contains.pack_start(contains_not_checkbox, False, False, 0)
        hbox_matches.pack_start(matches_not_checkbox, False, False, 0)

        hbox_is.pack_end(entry_is, False, False, 0)
        hbox_contains.pack_end(entry_contains, False, False, 0)
        hbox_matches.pack_end(entry_matches, False, False, 0)

        hbox_is.pack_end(MatchMethod_text_is, True, False, 0)
        hbox_contains.pack_end(MatchMethod_text_contains, True, False, 0)
        hbox_matches.pack_end(MatchMethod_text_matches, True, False, 0)

        # pack the rows
        vbox.pack_start(hbox_is, True, False, 0)
        vbox.pack_start(hbox_contains, True, False, 0)
        vbox.pack_start(hbox_matches, True, False, 0)

        # return the vbox we built so it gets packed into the property page
        return vbox




