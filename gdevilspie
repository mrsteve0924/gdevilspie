                                        for key in actions_dict[action_name]["input"]:
                                                storing = storing + " \"" + actions_dict[action_name]["input"][key].get_active_text() + "\""
                                else:
                                  for key in actions_dict[action_name]["input"]:
                                        storing = storing + " \"" + actions_dict[action_name]["input"][key].get_text() + "\""
                        strous += "( " + storing + " )\n"
